# NeuroLens backend settings.
# Copy this file to .env and fill in real values:   copy .env.example .env   (macOS/Linux: cp)
# Never commit .env. In Azure these are set as Web App application settings instead.

# --- MongoDB -----------------------------------------------------------
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net   ·   local: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=neurolens

# --- JWT authentication ------------------------------------------------
# Generate a long random secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Accounts ----------------------------------------------------------
# Let visitors create an account at /register (the first account ever created becomes an administrator).
# Switch off once your team has accounts; administrators can still add users on the Users page.
ALLOW_REGISTRATION=true
DEFAULT_USER_ROLE=clinician
# Optional: administrator created at start-up if this account does not exist yet (leave empty to skip)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Administrator

# --- CORS --------------------------------------------------------------
# Only needed when the dashboard runs separately (ng serve on :4200). Not needed in Docker/Azure,
# where the backend serves the dashboard from the same URL.
CORS_ORIGINS=http://localhost:4200

# --- Model (downloaded from Hugging Face at start-up) ------------------
HF_REPO_ID=Bharathikannan/thyroid-cancer-detection
HF_MODEL_FILENAME=thyroid_cancer_model.keras
# Output classes in the model's order. Thyroid (current): benign,malignant
# Brain tumor:  glioma,meningioma,notumor,pituitary
CLASS_NAMES=benign,malignant
MODEL_DISPLAY_NAME=Fibonacci-Net (thyroid model)

# --- Azure Blob Storage (scan images, heatmaps, reference library) --------
# Storage account > Access keys > Connection string. Leave empty to keep images inside MongoDB (local development).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=neurolens

# --- Optional ----------------------------------------------------------
# HF_REVISION=          pin a Hugging Face commit for reproducible deployments
# HF_TOKEN=             only needed for a private Hugging Face repository
# LOCAL_MODEL_PATH=     fallback model file if Hugging Face is unreachable (default: model_artifacts/<HF_MODEL_FILENAME>)
# SKIP_MODEL_LOAD=true  start without loading the model (used by the tests)
# SIMILAR_K=5          similar cases shown per scan
# USE_ATLAS_VECTOR_SEARCH=true   false = always use the exact in-API search
# BLOB_URL_MINUTES=60   how long image links stay valid
