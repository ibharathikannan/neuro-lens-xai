# Copy this file to .env and fill in real values. Never commit .env to Git.

# MongoDB Atlas connection string (or a local MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=neurolens

# JWT — generate a long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Account creation (the first account created becomes the administrator)
ALLOW_REGISTRATION=true
DEFAULT_USER_ROLE=clinician

# Angular dashboard origin(s), comma-separated
CORS_ORIGINS=http://localhost:4200

# Model registry (used later by the classification routes)
HF_REPO_ID=
HF_MODEL_FILENAME=brain_tumor_model.keras
